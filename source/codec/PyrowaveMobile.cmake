# Build a reproducible compatibility variant without editing the pinned checkout.
set(PYROWAVE_BUILD_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/mobile-pyrowave")
file(MAKE_DIRECTORY "${PYROWAVE_BUILD_SOURCE}/shaders")
file(GLOB PW_CORE_FILES "${PYROWAVE_SOURCE}/*.cpp" "${PYROWAVE_SOURCE}/*.hpp" "${PYROWAVE_SOURCE}/*.h")
file(COPY ${PW_CORE_FILES} "${PYROWAVE_SOURCE}/CMakeLists.txt" "${PYROWAVE_SOURCE}/LICENSE" DESTINATION "${PYROWAVE_BUILD_SOURCE}")
file(COPY "${PYROWAVE_SOURCE}/shaders/" DESTINATION "${PYROWAVE_BUILD_SOURCE}/shaders")
if(CMAKE_HOST_WIN32)
    set(PW_SHADER_HOST windows-x86_64)
elseif(CMAKE_HOST_APPLE)
    set(PW_SHADER_HOST darwin-x86_64)
else()
    set(PW_SHADER_HOST linux-x86_64)
endif()
find_program(PW_GLSLC glslc HINTS "${CMAKE_ANDROID_NDK}/shader-tools/${PW_SHADER_HOST}" REQUIRED)
file(READ "${CMAKE_CURRENT_LIST_DIR}/mobile-subgroups.glsl" PW_REDUCTIONS)
file(WRITE "${PYROWAVE_BUILD_SOURCE}/shaders/mobile-shaders.hpp" "#pragma once\n#include <stdint.h>\n")
foreach(shader block_packing wavelet_quant)
    file(READ "${PYROWAVE_SOURCE}/shaders/${shader}.comp" PW_GLSL)
    # All extensions must precede function definitions.
    string(REPLACE "#extension GL_KHR_shader_subgroup_clustered : require" "" PW_GLSL "${PW_GLSL}")
    string(REPLACE "#include \"constants.h\"" "#include \"constants.h\"\n${PW_REDUCTIONS}" PW_GLSL "${PW_GLSL}")
    string(REPLACE "subgroupClusteredAdd(" "pwClusteredAdd(" PW_GLSL "${PW_GLSL}")
    string(REPLACE "subgroupClusteredMax(" "pwClusteredMax(" PW_GLSL "${PW_GLSL}")
    set(PW_COMPAT_SOURCE "${PYROWAVE_BUILD_SOURCE}/shaders/${shader}-mobile.comp")
    file(WRITE "${PW_COMPAT_SOURCE}" "${PW_GLSL}")
    execute_process(COMMAND "${PW_GLSLC}" --target-env=vulkan1.1 -O -mfmt=c
        "-I${PYROWAVE_SOURCE}/shaders" "${PW_COMPAT_SOURCE}" -o "${PW_COMPAT_SOURCE}.inc"
        RESULT_VARIABLE PW_RESULT OUTPUT_VARIABLE PW_OUTPUT ERROR_VARIABLE PW_ERROR)
    if(NOT PW_RESULT EQUAL 0)
        message(FATAL_ERROR "Mobile Pyrowave shader failed: ${PW_OUTPUT}${PW_ERROR}")
    endif()
    file(READ "${PW_COMPAT_SOURCE}.inc" PW_WORDS)
    file(APPEND "${PYROWAVE_BUILD_SOURCE}/shaders/mobile-shaders.hpp" "static const uint32_t mobile_${shader}[] = ${PW_WORDS};\n")
endforeach()
file(READ "${PYROWAVE_SOURCE}/shaders/slangmosh.hpp" PW_HEADER)
string(REPLACE "namespace PyroWave\n{\nstatic const uint32_t spirv_bank[]" "namespace PyroWave\n{\n#include \"mobile-shaders.hpp\"\nstatic const uint32_t spirv_bank[]" PW_HEADER "${PW_HEADER}")
foreach(shader block_packing wavelet_quant)
    string(REGEX MATCH "this->${shader} = device.request_program\\(spirv_bank \\+ [0-9]+, [0-9]+, &layout\\);" PW_REQUEST "${PW_HEADER}")
    if(NOT PW_REQUEST)
        message(FATAL_ERROR "Pinned Pyrowave shader constructor changed: ${shader}")
    endif()
    string(REPLACE "${PW_REQUEST}"
        "if ((device.get_device_features().vk11_props.subgroupSupportedOperations & VK_SUBGROUP_FEATURE_CLUSTERED_BIT) == 0)\n\t\tthis->${shader} = device.request_program(mobile_${shader}, sizeof(mobile_${shader}), &layout);\n\telse\n\t\t${PW_REQUEST}"
        PW_HEADER "${PW_HEADER}")
endforeach()
file(WRITE "${PYROWAVE_BUILD_SOURCE}/shaders/slangmosh.hpp" "${PW_HEADER}")
file(READ "${PYROWAVE_SOURCE}/pyrowave_encoder.cpp" PW_ENCODER)
string(FIND "${PW_ENCODER}" "VK_SUBGROUP_FEATURE_CLUSTERED_BIT |" PW_GATE)
if(PW_GATE LESS 0)
    message(FATAL_ERROR "Pinned Pyrowave capability check changed")
endif()
string(REPLACE "VK_SUBGROUP_FEATURE_CLUSTERED_BIT |" "" PW_ENCODER "${PW_ENCODER}")
file(WRITE "${PYROWAVE_BUILD_SOURCE}/pyrowave_encoder.cpp" "${PW_ENCODER}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/mobile-subgroups.glsl"
    "${PYROWAVE_SOURCE}/shaders/wavelet_quant.comp" "${PYROWAVE_SOURCE}/shaders/block_packing.comp"
    "${PYROWAVE_SOURCE}/shaders/slangmosh.hpp" "${PYROWAVE_SOURCE}/pyrowave_encoder.cpp")
